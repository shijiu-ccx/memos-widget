<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.MemosTodoWidget" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">#4F75FF</item>
        <item name="colorSecondary">#435D9D</item>
        <item name="android:fontFamily">sans</item>
    </style>

    <style name="WidgetTodoRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:background">@drawable/widget_row_background</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
    </style>

    <style name="WidgetTodoText">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">1</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">14sp</item>
    </style>
</resources>

